# このファイルを .env にコピーして値を埋めてください。.env は絶対にコミットしないこと。

# ---- 受信（IMAP）----
# Gmail の場合: imap.gmail.com / 993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=deepseek.bot@example.com
# Gmail は通常のパスワードではなくアプリパスワード（16 桁）を使う
IMAP_PASSWORD=xxxxxxxxxxxxxxxx
IMAP_FOLDER=INBOX

# ---- 送信（SMTP）----
# Gmail の場合: smtp.gmail.com / 587（STARTTLS）または 465（SSL）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# 省略すると IMAP_USER / IMAP_PASSWORD を使う
#SMTP_USER=
#SMTP_PASSWORD=

# ---- ボットの動作 ----
# 返信の From に使うアドレス（省略時は SMTP_USER）
BOT_ADDRESS=deepseek.bot@example.com
BOT_NAME=DeepSeek Mail Bot
# ここに書いたアドレスからのメールにしか返信しない（カンマ区切り、@example.com のようなドメイン指定も可）
ALLOWED_SENDERS=haseko.86@gmail.com
# From の詐称を防ぐため、受信サーバの DKIM/SPF 判定を確認する。無効化は自己責任で。
REQUIRE_AUTH_RESULTS=true

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT=300

# ---- 上限値 ----
MAX_INPUT_CHARS=120000
MAX_ATTACHMENT_BYTES=20971520
MAX_OUTGOING_ATTACHMENT_BYTES=10485760
MAX_HISTORY_TURNS=12
MAX_MESSAGES_PER_RUN=10

# ---- その他 ----
STATE_DIR=state
DRY_RUN=false
